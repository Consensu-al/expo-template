# App configuration
# These variables are used for app.json/app.config.js configuration
EXPO_APP_NAME=Consensual Expo App
EXPO_APP_SLUG=consensual-template
EXPO_APP_VERSION=1.0.0
EXPO_APP_OWNER=your-expo-account

# Updates and EAS
EXPO_PROJECT_ID=your-expo-project-id
EXPO_UPDATES_URL=https://u.expo.dev/your-expo-project-id

# Android package
ANDROID_PACKAGE_NAME=com.yourcompany.appname

# App URL scheme (for deep linking)
URL_SCHEME=yourapp

# Client-accessible Variables 
# EXPO_PUBLIC_ prefix makes these available in the app at runtime
# API configuration
EXPO_PUBLIC_API_URL=https://api.example.com

# Database configuration
EXPO_PUBLIC_DB_NAME=app.db

# Feature flags (true/false as strings)
EXPO_PUBLIC_ENABLE_ANALYTICS=false
EXPO_PUBLIC_ENABLE_CRASH_REPORTING=false

# Logger configuration (debug, info, warn, error)
EXPO_PUBLIC_LOG_LEVEL=debug

# Environment indicator (development, staging, production)
EXPO_PUBLIC_ENVIRONMENT=development

# You can create environment-specific .env files:
# .env                # loaded in all environments
# .env.local          # loaded in all environments, ignored by git
# .env.development    # only loaded in development environment
# .env.production     # only loaded in production environment