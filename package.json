{
  "name": "consensual-expo-template",
  "main": "expo-router/entry",
  "version": "0.0.2",
  "description": "A robust Expo template with Zustand, Zod, Drizzle, React Native Paper, and FlashList",
  "keywords": [
    "expo",
    "template",
    "typescript",
    "zustand",
    "zod",
    "drizzle",
    "sqlite",
    "react-native-paper",
    "flash-list",
    "expo-router"
  ],
  "scripts": {
    "dev": "expo start --dev-client --clear",
    "dev:tunnel": "expo start --dev-client --clear --tunnel",
    "dev:android": "expo start -c --android",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "format": "biome check --no-errors-on-unmatched --write .",
    "format:unstaged": "git ls-files --modified --others --exclude-standard | xargs bunx @biomejs/biome check --fix",
    "expo-check": "bun expo install --check",
    "test": "jest --watchAll",
    "clean": "expo prebuild --clean",
    "prebuild": "expo prebuild",
    "prebuild:android": "expo prebuild -p android",
    "prebuild:android:clean": "expo prebuild --clean -p android"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@consensu.al/react-native-logger": "^0.3.0",
    "@expo/vector-icons": "^14.0.2",
    "@paralleldrive/cuid2": "^2.2.2",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/drawer": "^7.3.9",
    "@react-navigation/elements": "^2.3.8",
    "@react-navigation/native": "^7.0.14",
    "@shopify/flash-list": "^1.7.3",
    "drizzle-orm": "^0.42.0",
    "drizzle-zod": "^0.7.1",
    "expo": "~52.0.46",
    "expo-blur": "~14.0.3",
    "expo-constants": "~17.0.8",
    "expo-dev-client": "~5.0.20",
    "expo-font": "~13.0.4",
    "expo-haptics": "~14.0.1",
    "expo-linking": "~7.0.5",
    "expo-router": "^4.0.20",
    "expo-secure-store": "^14.0.1",
    "expo-splash-screen": "~0.29.24",
    "expo-sqlite": "^15.1.4",
    "expo-status-bar": "~2.0.1",
    "expo-symbols": "~0.2.2",
    "expo-system-ui": "~4.0.9",
    "expo-web-browser": "~14.0.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-paper": "^5.13.3",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.19.13",
    "react-native-webview": "13.12.5",
    "zod": "^3.24.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@biomejs/biome": "^1.9.4",
    "@expo/ngrok": "^4.1.3",
    "@types/jest": "^29.5.12",
    "@types/react": "~18.3.12",
    "@types/react-test-renderer": "^18.3.0",
    "babel-plugin-inline-import": "^3.0.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "drizzle-kit": "^0.31.0",
    "jest": "^29.2.1",
    "jest-expo": "~52.0.6",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.3.3"
  },
  "private": true,
  "trustedDependencies": ["esbuild"]
}
